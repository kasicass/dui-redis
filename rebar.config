%% -*- erlang -*-
%% dui-redis build configuration.

{erl_opts, [debug_info, warnings_as_errors]}.

{minimum_otp_vsn, "28"}.

{deps, [
    %% UI framework (git dep, as required).
    {educkui, {git, "https://github.com/kasicass/educkui.git", {branch, "main"}}},

    %% Redis client.
    {eredis, "~> 1.7"}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{dialyzer, [
    {warnings, [unknown, no_return, error_handling, unmatched_returns]},
    {plt_apps, all_deps}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{xref_queries, []}.
